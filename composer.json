{
    "name": "infrangible/m2-hyva-icons",
    "description": "Adds extra SVG icons in outline and solid style to Hyvä theme stores, for use by other Infrangible Hyvä modules and custom templates.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Hyvä"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-hyva-icons",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0",
        "hyva-themes/magento2-theme-module": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\HyvaIcons\\": "src"
        }
    }
}
