<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Hyva\Theme\ViewModel\SvgIcons">
        <arguments>
            <argument name="pathPrefixMapping" xsi:type="array">
                <item name="infrangible-outline" xsi:type="string">Infrangible_HyvaIcons::svg/outline</item>
                <item name="infrangible-solid" xsi:type="string">Infrangible_HyvaIcons::svg/solid</item>
            </argument>
        </arguments>
    </type>
    <type name="Infrangible\HyvaIcons\ViewModel\OutlineIcons">
        <arguments>
            <argument name="iconPathPrefix" xsi:type="string">Infrangible_HyvaIcons::svg/outline</argument>
        </arguments>
    </type>
    <type name="Infrangible\HyvaIcons\ViewModel\SolidIcons">
        <arguments>
            <argument name="iconPathPrefix" xsi:type="string">Infrangible_HyvaIcons::svg/solid</argument>
        </arguments>
    </type>
</config>
